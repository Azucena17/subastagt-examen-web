PORT=3000
# sqlserver: base SQL Server local; firebase: nube; demo: archivo JSON local.
DATA_MODE=sqlserver
SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=SubastaGT;Trusted_Connection=Yes;Encrypt=Yes;TrustServerCertificate=Yes;"
# Para Firebase, configura estas variables en el servidor:
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT=
# JSON público de la aplicación web Firebase (una sola línea):
FIREBASE_WEB_CONFIG=
